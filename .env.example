# ──────────────────────────────────────────────────────────────────
# Leader's High — Landing page 환경변수
# ──────────────────────────────────────────────────────────────────
# Vercel 프로젝트의 Environment Variables 섹션에 동일 키로 등록하세요.
# 클라이언트에서 접근 가능한 값만 NEXT_PUBLIC_* 로 노출되며,
# 서버 사이드 전용 값은 별도 키(예: META_CAPI_ACCESS_TOKEN)로 분리하세요.

# ── Meta Pixel (광고 전환 트래킹) ───────────────────────────────────
# Meta Business Suite → 이벤트 관리자 → 픽셀 생성 후 ID 복사
# 미설정 시 레이아웃에서 조용히 비활성화 (코드 수정 불필요)
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# ── 메인 서비스 URL (CTA 클릭 시 이동 대상) ─────────────────────────
# 기본값: https://leader-s-high.vercel.app/#/onboarding
# Preview/Staging 에서는 다른 URL 로 전환 가능
NEXT_PUBLIC_SERVICE_URL=https://leader-s-high.vercel.app/#/onboarding
